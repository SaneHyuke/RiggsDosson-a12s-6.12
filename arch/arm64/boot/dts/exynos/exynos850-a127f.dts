// SPDX-License-Identifier: GPL-2.0
/*
 * Samsung Galaxy A12s (SM-A127F), Exynos 850 / 3830
 *
 * Board-specific PMIC, camera, modem, and unported peripheral nodes must come
 * from the stock A12s DTBO only after each compatible binding is confirmed
 * for this 6.12 tree.
 */

/dts-v1/;

#include "exynos850.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "exynos-pinctrl.h"

/ {
	model = "Samsung Galaxy A12s";
	compatible = "samsung,a127f", "samsung,a12s", "samsung,exynos850";

	aliases {
		mmc0 = &mmc_0;
		serial0 = &serial_0;
		decon = &decon_0;
		dsim = &dsim_0;
		dpp0 = &dpp_0;
		dpp1 = &dpp_1;
		dpp2 = &dpp_2;
		dpp3 = &dpp_3;
		panel0 = &panel_0;
		panel_drv0 = &panel_drv_0;
	};

	chosen {
		stdout-path = &serial_0;
		bootargs = "console=ttyS0,115200n8 rootwait lcdtype=0xaa240";
	};

	reg_usb_dummy: regulator-usb-dummy {
		compatible = "regulator-fixed";
		regulator-name = "usb_dummy";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	nfc_pvdd: regulator-nfc-pvdd {
		compatible = "regulator-fixed";
		regulator-name = "nfc_pvdd";
		gpio = <&gpg1 3 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <&nfc_pvdd_pins>;
	};

	/* S2MPU12 LDO28 stays enabled by the bootloader at 1.8 V. */
	vdd_ldo28: regulator-ldo28 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_ldo28";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	lcd_fixed_regulator {
		compatible = "simple-bus";

		gpio_lcd_rst: lcd-rst {
			compatible = "regulator-fixed";
			regulator-name = "gpio_lcd_rst";
			gpio = <&gpg2 4 GPIO_ACTIVE_HIGH>;
			enable-active-high;
			regulator-boot-on;
		};

		gpio_lcd_bl_en: lcd-bl-en {
			compatible = "regulator-fixed";
			regulator-name = "gpio_lcd_bl_en";
			gpio = <&gpg2 1 GPIO_ACTIVE_HIGH>;
			enable-active-high;
			regulator-boot-on;
		};
	};

	/* Two 2 GiB ranges from the Android 13 S5E3830 device tree.
	 * The secure/bootloader reserved regions are not modeled here yet.
	 */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x80000000>,
		      <0x8 0x80000000 0x80000000>;
	};

	mali: mali@11500000 {
		compatible = "arm,mali-bifrost", "arm,mali";
		reg = <0x0 0x11500000 0x5000>;
		interrupts = <GIC_SPI 126 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 127 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 125 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "JOB", "MMU", "GPU";
		governor = "interactive";
		gpu_dvfs_table_size = <0x06 0x07>;
		gpu_dvfs_table = <0xf4628 0x5f 0x64 0x01 0x177bb8 0x1e8c50 0x00
				  0xd32e8 0x50 0x5a 0x01 0x177bb8 0x1e8c50 0x00
				  0xb8150 0x50 0x5a 0x01 0x14a140 0x163780 0x00
				  0x91ff0 0x46 0x5a 0x01 0xf78f0 0x101148 0x00
				  0x69b68 0x3c 0x50 0x01 0xce4c8 0xc4c70 0x00
				  0x5c0a8 0x00 0x46 0x01 0xa50a0 0x9eb10 0x00>;
		gpu_max_clock = <0xf4628>;
		gpu_max_clock_limit = <0xf4628>;
		gpu_min_clock = <0x5c0a8>;
		gpu_dvfs_start_clock = <0x5c0a8>;
		gpu_dvfs_bl_config_clock = <0x5c0a8>;
		gpu_dvfs_time_interval = <0x05>;
		gpu_dvfs_polling_time = <0x1e>;
		gpu_tmu_control = <0x01>;
		gpu_bts_support = <0x01>;
		status = "okay";
	};

	gpio-keys {
		compatible = "gpio-keys";
		autorepeat;

		key-power {
			label = "Power";
			gpios = <&gpa1 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			wakeup-source;
		};

		key-volume-up {
			label = "Volume Up";
			gpios = <&gpa0 7 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};

		key-volume-down {
			label = "Volume Down";
			gpios = <&gpa1 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
		};
	};

	panel_0: panel_0 {
		compatible = "samsung,exynos-panel";
		lcd_info = <&nt36525b_ctc>;
	};

	panel_drv_0: panel_drv@0 {
		compatible = "samsung,panel-drv";
		status = "okay";
		ddi-info = <&nt36525b_ctc>;
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;
		pinctrl-names = "default";
		pinctrl-0 = <&disp_rst_ctrl &disp_blen_ctrl &disp_lcd_id>;

		regulators {
			gpio_lcd_bl_en {
				regulator = <&gpio_lcd_bl_en>;
			};
		};

		panel-lookup {
			panel-id-addr = <0xda 0xdb 0xdc>;
			panel-id-len = <0x01 0x01 0x01>;
			panel-name = "nt36525b_ctc_a12s_default";
			panel-ddi-info = <&nt36525b_ctc>;
			panel-lut = <0xaa240 0xffffff 0x00 0x00>;
		};
	};

	decon_board_nt36525b: decon_board_nt36525b {
		panel_boot_enable {
			type = "regulator,enable", "vdd_ldo28", "regulator,enable", "gpio_lcd_rst", "regulator,enable", "gpio_lcd_bl_en";
		};

		panel_power_enable {
			type = "regulator,enable", "vdd_ldo28", "delay,usleep", "1000", "regulator,enable", "gpio_lcd_bl_en", "delay,usleep", "1000";
		};

		panel_power_disable {
			type = "delay,usleep", "3000", "regulator,disable", "gpio_lcd_bl_en", "delay,usleep", "5000", "regulator,disable", "vdd_ldo28", "delay,msleep", "30";
		};

		panel_reset {
			type = "delay,usleep", "10000", "regulator,enable", "gpio_lcd_rst", "delay,usleep", "1000", "regulator,disable", "gpio_lcd_rst", "delay,usleep", "3500", "regulator,enable", "gpio_lcd_rst", "delay,usleep", "10000";
		};

		panel_reset_disable {
			type = "delay,msleep", "60", "regulator,disable", "gpio_lcd_rst", "delay,usleep", "5000";
		};

		panel_not_connected {
			type = "regulator,disable", "vdd_ldo28", "regulator,disable", "gpio_lcd_rst", "regulator,disable", "gpio_lcd_bl_en";
		};
	};

	nt36525b_ctc: nt36525b_ctc {
		id = <0xaa240>;
		decon_board = <&decon_board_nt36525b>;
		mode = <0x00>;
		resolution = <0x2d0 0x640>;
		size = <0x44 0x97>;
		timing,refresh = <0x3c>;
		timing,h-porch = <0x6e 0x46 0x1c>;
		timing,v-porch = <0xfc 0x08 0x02>;
		timing,dsi-hs-clk = <0x33e>;
		timing,pmsk = <0x02 0xff 0x02 0x6276 0x00 0x00 0x00 0x00
			       0x00 0x00 0x00 0x00 0x00 0x00>;
		timing,dsi-escape-clk = <0x14>;
		type_of_ddi = <0x00>;
		dsc_en = <0x00>;
		dsc_cnt = <0x00>;
		dsc_slice_num = <0x00>;
		dsc_slice_h = <0x00>;
		data_lane = <0x03>;
		mres_en = <0x00>;
		active_fps = <0x3c>;
		default_mode = <0x00>;
		display_mode = <0x2d0 0x640 0x3c 0x00 0x00 0x00 0x00 0x08>;
		hdr_num = <0x00>;
		hdr_type = <0x02 0x00 0x00 0x00>;
		hdr_max_luma = <0x5265c0>;
		hdr_max_avg_luma = <0x124f80>;
		hdr_min_luma = <0x05>;
	};

};

&bootloader_fb {
	reg = <0x00 0xfa000000 0xd00000>;
	status = "okay";
};

&pinctrl_alive {
	decon_te_on: decon-te-on {
		samsung,pins = "gpa4-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
	};

	decon_te_off: decon-te-off {
		samsung,pins = "gpa4-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
	};

	tsp_irq_on: tsp-irq-on {
		samsung,pins = "gpa0-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
	};

	tsp_irq_off: tsp-irq-off {
		samsung,pins = "gpa0-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};

	tsp_rst_on: tsp-rst-on {
		samsung,pins = "gpa3-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-val = <1>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};

	tsp_rst_off: tsp-rst-off {
		samsung,pins = "gpa3-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};

	tsp_id3_on: tsp-id3-on {
		samsung,pins = "gpa0-2";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};

	tsp_id3_off: tsp-id3-off {
		samsung,pins = "gpa0-2";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};

	nfc_xclkout: nfc-xclkout {
		samsung,pins = "gpq0-2";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};

	nfc_xclkout_nc: nfc-xclkout-nc {
		samsung,pins = "gpq0-2";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};

	nfc_clk_req: nfc-clk-req {
		samsung,pins = "gpa3-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};

	nfc_clk_req_nc: nfc-clk-req-nc {
		samsung,pins = "gpa3-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};
};

&pinctrl_cmgp {
	spi1_bus_pins: spi1-bus-pins {
		samsung,pins = "gpm0-0", "gpm1-0", "gpm2-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
	};

	spi1_cs_pins: spi1-cs-pins {
		samsung,pins = "gpm3-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-val = <1>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
	};
};

&pinctrl_peri {
	disp_rst_ctrl: disp-rst-ctrl {
		samsung,pins = "gpg2-4";
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
	};

	disp_blen_ctrl: disp-blen-ctrl {
		samsung,pins = "gpg2-1";
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
	};

	disp_lcd_id: disp-lcd-id {
		samsung,pins = "gpg1-7", "gpg2-0";
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_INPUT>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
	};

	tsp_id_on: tsp-id-on {
		samsung,pins = "gpg1-7", "gpg2-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};

	tsp_id_off: tsp-id-off {
		samsung,pins = "gpg1-7", "gpg2-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};

	nfc_i2c_pins: nfc-i2c-pins {
		samsung,pins = "gpp0-5", "gpp0-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
	};

	nfc_pvdd_pins: nfc-pvdd-pins {
		samsung,pins = "gpg1-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
	};

	nfc_en: nfc-en {
		samsung,pins = "gpg1-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
	};

	nfc_en_nc: nfc-en-nc {
		samsung,pins = "gpg1-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_INPUT>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_DOWN>;
	};

	nfc_firm: nfc-firm {
		samsung,pins = "gpg1-2";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-val = <0>;
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
	};

	nfc_firm_nc: nfc-firm-nc {
		samsung,pins = "gpg1-2";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_INPUT>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_DOWN>;
	};

	nfc_check: nfc-check {
		samsung,pins = "gpg1-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV2>;
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_INPUT>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
	};

	sm5714_irq_pins: sm5714-irq-pins {
		samsung,pins = "gpa2-5";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_INPUT>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
	};
};

&oscclk {
	clock-frequency = <26000000>;
};

&i2c_2 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&nfc_i2c_pins>;

	pn547@2b {
		compatible = "pn547";
		reg = <0x2b>;
		pn547,irq-gpio = <&gpa1 3 GPIO_ACTIVE_HIGH>;
		pn547,ven-gpio = <&gpg1 0 GPIO_ACTIVE_HIGH>;
		pn547,firm-gpio = <&gpg1 2 GPIO_ACTIVE_HIGH>;
		pn547,clk_req-gpio = <&gpa3 4 GPIO_ACTIVE_HIGH>;
		pn547,ap_vendor = "slsi";
		pn547,nfc-det-gpio = <&gpg1 4 GPIO_ACTIVE_HIGH>;
		pn547,ldo_control;
		nfc_pvdd-supply = <&nfc_pvdd>;
		pn547,irq_all_trigger;
		clocks = <&cmu_top CLK_OSC_NFC>;
		clock-names = "oscclk_nfc";
		pinctrl-names = "default", "nfc_nc";
		pinctrl-0 = <&nfc_en &nfc_firm &nfc_xclkout &nfc_clk_req &nfc_check>;
		pinctrl-1 = <&nfc_en_nc &nfc_firm_nc &nfc_xclkout_nc &nfc_clk_req_nc>;
	};
};

&i2c_1 {
	status = "okay";
	clock-frequency = <400000>;

	lm36274@11 {
		compatible = "panel_i2c";
		reg = <0x11>;
	};
};

&i2c_3 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins>;

	sm5714@49 {
		compatible = "siliconmitus,sm5714mfd";
		reg = <0x49>;
		pinctrl-names = "default";
		pinctrl-0 = <&sm5714_irq_pins>;
		sm5714,irq-gpio = <&gpa2 5 GPIO_ACTIVE_HIGH>;
		sm5714,wakeup;

		sm5714-fuelgauge {
			status = "okay";
			fuelgauge,fuel_alert_soc = <0x01>;
			fuelgauge,capacity_max = <0x3e8>;
			fuelgauge,capacity_max_margin = <0x12c>;
			fuelgauge,capacity_min = <0x00>;
			fuelgauge,capacity_calculation_type = <0x1f>;
			fuelgauge,using_temp_compensation;
			fuelgauge,low_temp_limit = <0x64>;
			fuelgauge,using_hw_vempty;
			fuelgauge,sw_v_empty_voltage = <0xc80>;
			fuelgauge,sw_v_empty_voltage_cisd = <0xc1c>;
			fuelgauge,sw_v_empty_recover_voltage = <0xd98>;
			fuelgauge,capacity = <0x1388>;

			battery_params {
				battery,id = <0x00>;
				battery0,battery_type = <0x1130 0x2406>;
				battery0,battery_table0 = <0x1400 0x1b49 0x1c6e 0x1d41 0x1d71 0x1d80 0x1d94 0x1dda 0x1e17 0x1e3b 0x1e53 0x1e71 0x1e97 0x1ee7 0x1f14 0x1f58 0x1fb5 0x1fec 0x2025 0x2095 0x20e3 0x2122 0x2226 0x2400>;
				battery0,battery_table1 = <0x00 0x99 0x24c 0x480 0x599 0x74c 0xccc 0x1266 0x1ab3 0x204c 0x25cc 0x2b66 0x30e6 0x3933 0x3c00 0x3ecc 0x4466 0x49e6 0x4cb3 0x4f80 0x5500 0x57cc 0x6400 0x6419>;
				battery0,battery_table2 = <0x4b4b 0x4444 0x4040 0x3e3e 0x3c3c 0x3b3b 0x3838 0x3737 0x3535 0x3434 0x3434 0x3333 0x3333 0x3333 0x3333 0x3232>;
				battery0,rs_value = <0x48 0x48 0x3800 0x10a 0x599 0x599 0x50>;
				battery0,v_alarm = <0xc1c 0xc8>;
				battery0,topoff = <0x1f4>;
				battery0,i_cal = <0x01 0x00 0x800 0x800 0x00 0x00 0x7e8 0x818>;
				battery0,v_cal = <0x01 0x00 0x00 0x01 0x00 0x00 0x00>;
				battery0,temp_std = <0x19>;
				battery0,tem_poff = <0xd48 0x32 0xcb2 0x32>;
				battery0,aux_ctrl = <0x322 0x5800>;
				battery0,data_ver = <0x03>;
				battery0,v_max_table = <0x2226 0x2203 0x21e0 0x21bc 0x2165>;
				battery0,q_max_table = <0x2406 0x235f 0x22b9 0x2212 0x2071>;
			};
		};

		sm5714-charger {
			status = "okay";
			compatible = "samsung,sm5714-charger";
			sm5714,chg_lxslope = <0x02>;
		};
	};

	sma1303@1e {
		compatible = "siliconmitus,sma1303";
		reg = <0x1e>;
		#sound-dai-cells = <1>;
		status = "okay";
	};
};

&dsim_0 {
	memory-region = <&bootloader_fb>;
};

&serial_0 {
	status = "okay";
};

&usi_uart {
	samsung,clkreq-on;
	status = "okay";
};

&usi_cmgp0 {
	samsung,mode = <USI_V2_SPI>;
	status = "okay";
};

&spi_1 {
	status = "okay";
	num-cs = <3>;
	no-cs-readback;
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_bus_pins>;

	/* Only the nt36525b CTC panel selected by lcdtype=0xaa240 is active. */
	ilitek@0 {
		compatible = "iliteck,ili9882x-spi";
		status = "disabled";
		reg = <0>;
		spi-max-frequency = <5000000>;
		pinctrl-names = "default", "on_state", "off_state";
		pinctrl-0 = <&tsp_id_on &tsp_id3_on &tsp_irq_on &spi1_cs_pins &tsp_rst_on>;
		pinctrl-1 = <&tsp_id_on &tsp_id3_on &tsp_irq_on &spi1_cs_pins &tsp_rst_on>;
		pinctrl-2 = <&tsp_id_off &tsp_id3_off &tsp_irq_off &tsp_rst_off>;
		iliteck,irq-gpio = <&gpa0 0 0x2008>;
		iliteck,reset-gpio = <&gpa3 0 0>;
		iliteck,cs-gpio = <&gpm3 0 0>;
		iliteck,lcdid1-gpio = <&gpg1 7 0>;
		iliteck,lcdid2-gpio = <&gpg2 0 0>;
		iliteck,lcdid3-gpio = <&gpa0 2 0>;
		iliteck,lcd_rst = "gpio_lcd_rst";
		iliteck,lcd_bl_en = "gpio_lcd_bl_en";
		iliteck,lcd_vddi = "vdd_ldo28";
		iliteck,irq-on-state = <0>;
		iliteck,spi-mode = <0>;
		iliteck,byte-delay-us = <0>;
		iliteck,block-delay-us = <0>;
		iliteck,ubl-max-freq = <5000000>;
		iliteck,ubl-byte-delay-us = <20>;
		iliteck,area-size = <0x30 0x51 0x1e>;
		iliteck,enable_settings_aot;
		iliteck,enable_sysinput_enabled;
		iliteck,support_ear_detect_mode;
		iliteck,prox_lp_scan_enabled;
		iliteck,lcd_rst_delay = <2>;
		iliteck,lcdid = <0x03 0x07>;
		iliteck,lcdtype = <0x00 0x00 0x00 0xba7254
				   0x00 0x00 0x00 0x3a6250>;
		iliteck,fw_name = "", "", "",
			"tsp_ilitek/ili7807s_a12s.hex", "", "", "",
			"tsp_ilitek/ili9882_a12s.hex";
	};

	novatek@1 {
		compatible = "novatek,NVT-ts-spi";
		reg = <1>;
		spi-max-frequency = <9600000>;
		pinctrl-names = "default", "on_state", "off_state";
		pinctrl-0 = <&tsp_id_on &tsp_id3_on &tsp_irq_on &spi1_cs_pins &tsp_rst_on>;
		pinctrl-1 = <&tsp_id_on &tsp_id3_on &tsp_irq_on &spi1_cs_pins &tsp_rst_on>;
		pinctrl-2 = <&tsp_id_off &tsp_id3_off &tsp_irq_off &tsp_rst_off>;
		novatek,reset-gpio = <&gpa3 0 0>;
		novatek,irq-gpio = <&gpa0 0 0x2002>;
		novatek,cs-gpio = <&gpm3 0 0>;
		novatek,lcdid1-gpio = <&gpg1 7 0>;
		novatek,lcdid2-gpio = <&gpg2 0 0>;
		novatek,lcdid3-gpio = <&gpa0 2 0>;
		novatek,resolution = <0x2d0 0x640>;
		novatek,enable_settings_aot;
		novatek,support_ear_detect_mode;
		novatek,prox_lp_scan_enabled;
		novatek,enable_sysinput_enabled;
		novatek,lcdid = <0x01 0x02 0x06>;
		novatek,lcdtype = <0x00 0xaa240 0xa1240
				   0x00 0x00 0x00 0xaf240>;
		novatek,fw_name = "",
			"tsp_novatek/nt36525_a12s_csot.bin",
			"tsp_novatek/nt36525_a12s_dtc.bin",
			"", "", "",
			"tsp_novatek/nt36525_a12s_sharp.bin";
		novatek,fw_name_mp = "",
			"tsp_novatek/nt36525_a12s_mp_csot.bin",
			"tsp_novatek/nt36525_a12s_mp_dtc.bin",
			"", "", "",
			"tsp_novatek/nt36525_a12s_mp_sharp.bin";
		novatek,regulator_lcd_vdd = "vdd_ldo28";
		novatek,regulator_lcd_reset = "gpio_lcd_rst";
		novatek,regulator_lcd_bl = "gpio_lcd_bl_en";
		novatek,swrst-n8-addr = <0x3f0fe>;
		novatek,spi-rd-fast-addr = <0x3f310>;
		novatek,mp-support-dt;

		novatek-mp-criteria-722E@0 {
			compatible = "novatek-mp-criteria-722E";
			open_test_spec = <0xfffffe01 0x1400>;
			short_test_spec = <0x2710 0x36b8>;
			diff_test_frame = <0x32>;
			fdm_x_num = <0x02>;
		};

		novatek-mp-criteria-7232@0 {
			compatible = "novatek-mp-criteria-7232";
			open_test_spec = <0xfffffe01 0x1400>;
			short_test_spec = <0x2710 0x36b8>;
			diff_test_frame = <0x32>;
			fdm_x_num = <0x02>;
		};

		novatek-mp-criteria-7231@0 {
			compatible = "novatek-mp-criteria-7231";
			open_test_spec = <0xfffffe01 0x1400>;
			short_test_spec = <0x2710 0x36b8>;
			diff_test_frame = <0x32>;
			fdm_x_num = <0x02>;
		};
	};

	synaptics@2 {
		compatible = "synaptics,tcm-spi";
		status = "disabled";
		reg = <2>;
		spi-max-frequency = <7000000>;
		pinctrl-names = "default", "on_state", "off_state";
		pinctrl-0 = <&tsp_id_on &tsp_id3_on &tsp_irq_on &spi1_cs_pins &tsp_rst_on>;
		pinctrl-1 = <&tsp_id_on &tsp_id3_on &tsp_irq_on &spi1_cs_pins &tsp_rst_on>;
		pinctrl-2 = <&tsp_id_off &tsp_id3_off &tsp_irq_off &tsp_rst_off>;
		synaptics,irq-gpio = <&gpa0 0 0x2008>;
		synaptics,irq-on-state = <0>;
		synaptics,cs-gpio = <&gpm3 0 0>;
		synaptics,spi-mode = <3>;
		synaptics,byte-delay-us = <0>;
		synaptics,block-delay-us = <0>;
		synaptics,ubl-max-freq = <7000000>;
		synaptics,ubl-byte-delay-us = <20>;
		synaptics,area-size = <0x30 0x51 0x1e>;
		synaptics,regulator_lcd_vdd = "vdd_ldo28";
		synaptics,regulator_lcd_bl = "gpio_lcd_bl_en";
		synaptics,regulator_lcd_reset = "gpio_lcd_rst";
		synaptics,lcdid1-gpio = <&gpg1 7 0>;
		synaptics,lcdid2-gpio = <&gpg2 0 0>;
		synaptics,lcdid3-gpio = <&gpa0 2 0>;
		synaptics,enable_settings_aot;
		synaptics,support_cs_gpio_control;
		synaptics,support_ear_detect_mode;
		synaptics,prox_lp_scan_enabled;
		synaptics,enable_sysinput_enabled;
		synaptics,lcdid = <0x00 0x04 0x05>;
		synaptics,lcdtype = <0x7a6220 0x00 0x00
				    0x00 0x3a6220 0xba6220>;
		synaptics,fw_name = "tsp_synaptics/td4375_a12s_boe.bin",
			"", "", "",
			"tsp_synaptics/td4150_a12s_boe.bin",
			"tsp_synaptics/td4160_a12s_boe.bin";
	};
};

&mmc_0 {
	status = "okay";
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	cap-mmc-highspeed;
	non-removable;
	mmc-hs400-enhanced-strobe;
	bus-width = <8>;
};

&usbdrd {
	status = "okay";
	vdd10-supply = <&reg_usb_dummy>;
	vdd33-supply = <&reg_usb_dummy>;
};

&usbdrd_dwc3 {
	dr_mode = "peripheral";
};

&usbdrd_phy {
	status = "okay";
};

&watchdog_cl0 {
	status = "okay";
};

&watchdog_cl1 {
	status = "okay";
};

&exynos_adc {
	status = "okay";
};

